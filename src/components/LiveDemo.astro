---
// LiveDemo - the spotlight project running inside the page: one tab per demo role, a poster until
// the visitor starts it, then an iframe on /demo/:role (scripts/live-demo.ts)
import type { ProjectView } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  project: ProjectView;
}
const { project } = Astro.props;
const demo = project.data.liveDemo!;
const first = demo.roles[0]!;
const host = new URL(demo.base).host;
---

<div id="live-demo" class="scroll-mt-28" data-live-demo data-base={demo.base} data-warmup={demo.warmup}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div role="tablist" aria-label="Choose a role" class="glass-soft inline-flex flex-wrap gap-1 rounded-2xl p-1">
      {
        demo.roles.map((role, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            class="inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-semibold text-text-2 transition hover:text-text-1 aria-selected:bg-accent-500/20 aria-selected:text-accent-200 aria-selected:ring-1 aria-selected:ring-accent-400/40"
            data-demo-tab
            data-path={role.path}
            data-device={role.device}
            data-poster={role.poster}
            data-blurb={role.blurb}
            data-label={role.label}
          >
            <Icon name={role.device === "phone" ? "smartphone" : "monitor"} />
            {role.label}
          </button>
        ))
      }
    </div>
    <span class="inline-flex items-center gap-2 text-xs text-text-3" data-demo-status>
      <span class="size-1.5 rounded-full bg-text-3" data-demo-dot></span>
      <span data-demo-status-text>Live app, not a video</span>
    </span>
  </div>

  <p class="mt-3 min-h-[2.75rem] text-sm leading-relaxed text-text-2" data-demo-blurb>{first.blurb}</p>

  <div class="mt-3" data-demo-device={first.device}>
    <div class="demo-shell overflow-hidden rounded-2xl bg-ink-900 ring-1 ring-white/10" data-demo-shell>
      <div class="flex items-center gap-3 border-b border-white/8 bg-white/[0.03] px-3 py-2" data-demo-chrome>
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-[#ff5f57]/80"></span>
          <span class="size-2.5 rounded-full bg-[#febc2e]/80"></span>
          <span class="size-2.5 rounded-full bg-[#28c840]/80"></span>
        </span>
        <span class="min-w-0 flex-1 truncate rounded-md bg-ink-950/70 px-3 py-1 text-center font-mono text-[11px] text-text-3" data-demo-url>
          {host}{first.path}
        </span>
        <a href={`${demo.base}${first.path}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[11px] font-medium text-text-3 hover:text-text-1" data-demo-open>
          New tab <Icon name="arrow-up-right" />
        </a>
      </div>
      <div class="demo-screen relative" data-demo-screen>
        <img src={first.poster} alt={`${project.data.title}, ${first.label} screen`} class="absolute inset-0 size-full object-cover object-top" data-demo-poster loading="lazy" decoding="async" />
        <div class="absolute inset-0 grid place-items-center bg-gradient-to-t from-ink-950/90 via-ink-950/45 to-ink-950/20 p-6 text-center" data-demo-overlay>
          <div>
            <button type="button" class="btn-primary !px-6 !py-3 text-base" data-demo-launch>
              <Icon name="play" /> Launch the live app
            </button>
            <p class="mx-auto mt-3 max-w-xs text-xs leading-relaxed text-text-2" data-demo-launch-note>
              Signs you in as the demo {first.label.toLowerCase()}. No account needed.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-text-3">{demo.note}</p>
</div>

<style>
  .demo-screen {
    aspect-ratio: 16 / 10;
  }
  [data-demo-device="phone"] .demo-shell {
    max-width: 340px;
    margin-inline: auto;
    border-radius: 2.25rem;
    border: 8px solid #1d2a2e;
  }
  [data-demo-device="phone"] [data-demo-chrome] {
    display: none;
  }
  [data-demo-device="phone"] .demo-screen {
    aspect-ratio: 390 / 780;
  }
  .demo-screen :global(iframe) {
    position: absolute;
    left: 0;
    top: 0;
    border: 0;
    transform-origin: 0 0;
    background: #f8fafc;
  }
</style>
