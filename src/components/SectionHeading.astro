---
// SectionHeading - eyebrow, title and optional lead for a page section
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}
const { eyebrow, title, lead, align = "left" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-5 font-display text-3xl font-bold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]">{title}</h2>
  {lead && <p class="mt-4 text-base leading-relaxed text-text-2">{lead}</p>}
</div>
