---
// StoryDetails - the BA side of a project: problem, role, highlights, numbers, artifacts and links
import { ARTIFACT_ICONS, type ProjectView } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  project: ProjectView;
  /** Hide the problem paragraph when the card already shows it elsewhere. */
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { story, data } = project;
const metricCols = story.metrics.length >= 4 ? "grid-cols-2 sm:grid-cols-4" : "grid-cols-3";
---

<div class="space-y-6">
  {
    !compact && (
      <div>
        <p class="text-xs font-semibold tracking-widest text-text-3 uppercase">The problem</p>
        <p class="mt-2 text-[15px] leading-relaxed text-text-2">{story.problem}</p>
      </div>
    )
  }

  <div class="flex items-start gap-3 rounded-2xl border border-accent-400/20 bg-accent-500/[0.07] px-4 py-3">
    <Icon name="target" class="mt-0.5 size-[18px] text-accent-300" />
    <p class="text-sm leading-relaxed text-text-1"><span class="text-text-3">My role · </span>{story.role}</p>
  </div>

  {
    story.highlights.length > 0 && (
      <ul class="space-y-2.5">
        {story.highlights.map((item) => (
          <li class="flex gap-3 text-sm leading-relaxed text-text-2">
            <Icon name="check" class="mt-1 size-4 text-mint-400" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    story.metrics.length > 0 && (
      <dl class={`grid gap-2.5 ${metricCols}`}>
        {story.metrics.map((metric) => (
          <div class="rounded-2xl bg-white/[0.035] px-3.5 py-3 ring-1 ring-white/[0.06]">
            <dt class="text-[11px] leading-tight text-text-3">{metric.label}</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-text-1 tabular-nums" data-count={metric.value}>
              {metric.value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    story.artifacts.length > 0 && (
      <div>
        <p class="text-xs font-semibold tracking-widest text-text-3 uppercase">BA artifacts</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {story.artifacts.map((artifact) => (
            <a class="chip" href={artifact.href} target="_blank" rel="noopener">
              <Icon name={ARTIFACT_ICONS[artifact.kind]} class="text-accent-400" />
              {artifact.label}
            </a>
          ))}
        </div>
      </div>
    )
  }

  <div class="flex flex-wrap gap-1.5">
    {data.stack.map((tech) => <span class="rounded-md bg-white/[0.04] px-2 py-0.5 font-mono text-[11px] text-text-3">{tech}</span>)}
  </div>

  <div class="flex flex-wrap gap-2.5 pt-1">
    {
      project.hasCaseStudy && (
        <a href={`/projects/${project.id}/`} class="btn-primary">
          Read the case study <Icon name="arrow-right" />
        </a>
      )
    }
    {
      data.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class="btn-ghost !px-4">
          <Icon name={link.href.includes("github.com") ? "github" : "arrow-up-right"} />
          {link.label}
        </a>
      ))
    }
  </div>
</div>
