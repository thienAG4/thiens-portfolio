---
// 404 - page not found
import Icon from "@/components/Icon.astro";
import Base from "@/layouts/Base.astro";
import { getProfile } from "@/lib/content";

const profile = await getProfile();
---

<Base title={`Not found · ${profile.name}`} description="This page does not exist." profile={profile}>
  <section class="mx-auto grid min-h-[70vh] max-w-xl place-items-center px-4 pt-32 text-center">
    <div>
      <p class="font-display text-7xl font-extrabold text-gradient">404</p>
      <h1 class="mt-4 font-display text-2xl font-bold">This page is not in the spec</h1>
      <p class="mt-3 text-text-2">The link may be old, or the page moved.</p>
      <a href="/" class="btn-primary mt-8"><Icon name="arrow-left" /> Back home</a>
    </div>
  </section>
</Base>
