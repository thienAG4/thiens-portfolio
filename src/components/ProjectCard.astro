---
// ProjectCard - one project told for the current role: keyword story on one side, a media panel
// with "Workflow" and "Screens" tabs on the other (screens open in the zoom viewer)
import { diagramMarkup } from "@/lib/diagram-markup";
import type { ProjectView } from "@/lib/content";
import Diagram from "./Diagram.astro";
import Icon from "./Icon.astro";
import ProjectHeader from "./ProjectHeader.astro";
import StoryDetails from "./StoryDetails.astro";

interface Props {
  project: ProjectView;
  flip?: boolean;
}
const { project, flip = false } = Astro.props;
const { workflow } = project.story;
const screens = project.data.screens;
const tabs = [workflow && "workflow", screens.length > 0 && "screens"].filter(Boolean) as string[];
---

<article class="glass spotlight rounded-[28px] p-5 sm:p-8" data-reveal data-spotlight>
  <ProjectHeader project={project} />
  <div class="mt-8 grid items-start gap-8 lg:grid-cols-2">
    <div class:list={[flip && "lg:order-2"]}>
      <StoryDetails project={project} />
    </div>

    <div class:list={["lg:sticky lg:top-28", flip && "lg:order-1"]} data-media>
      {
        tabs.length > 1 && (
          <div role="tablist" aria-label={`${project.data.title} media`} class="glass-soft mb-3 inline-flex gap-1 rounded-2xl p-1">
            {tabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-media-tab={tab}
                class="inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-semibold text-text-2 transition hover:text-text-1 aria-selected:bg-accent-500/20 aria-selected:text-accent-200"
              >
                <Icon name={tab === "workflow" ? "workflow" : "image"} />
                {tab === "workflow" ? "Workflow" : `Screens (${screens.length})`}
              </button>
            ))}
          </div>
        )
      }

      {
        workflow && (
          <div data-media-pane="workflow">
            <Diagram mermaid={workflow.mermaid} title={workflow.title} caption={workflow.caption} height={560} />
          </div>
        )
      }

      {
        screens.length > 0 && (
          <div data-media-pane="screens" hidden={Boolean(workflow)}>
            <ul class="grid grid-cols-2 gap-3">
              {screens.map((screen, i) => (
                <li>
                  <button
                    type="button"
                    class="group relative block w-full overflow-hidden rounded-2xl ring-1 ring-white/10"
                    data-lightbox={`${project.id}-screen-${i}`}
                    aria-label={`Open ${screen.title}`}
                  >
                    <img
                      src={screen.src}
                      alt={screen.title}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
                    />
                    <span class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-ink-950/95 to-transparent px-3 pt-8 pb-2.5 text-left text-xs font-medium text-text-1">
                      {screen.title}
                      <Icon name="maximize" class="text-accent-300 opacity-0 transition group-hover:opacity-100" />
                    </span>
                  </button>
                  <template id={`${project.id}-screen-${i}`} set:html={diagramMarkup({ image: screen.src, title: screen.title })} />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {!workflow && screens.length === 0 && project.data.cover && <Diagram image={project.data.cover} title={`${project.data.title} screen`} height={420} />}
    </div>
  </div>
</article>
