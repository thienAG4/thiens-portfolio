---
// Hero - kept light on purpose: availability, two-line headline, one line of intro and two buttons
// over an interactive constellation (scripts/constellation.ts) that reacts to the cursor
import type { Role } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  role: Role;
  spotlightTitle: string;
}
const { role, spotlightTitle } = Astro.props;
const [lineOne, lineTwo] = role.data.headline;
const firstLine = lineOne.split(" ").map((word, i) => ({ word, delay: 120 + i * 70 }));
// The gradient line rises as one piece: background-clip text breaks on separately animated words.
const secondLineDelay = 120 + firstLine.length * 70;
---

<section id="home" class="relative isolate flex min-h-[92svh] items-center justify-center overflow-hidden px-4 pt-28 pb-20 sm:px-6">
  <div class="hero-sky pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 h-[420px] w-[min(1100px,90vw)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-500/12 blur-[120px]"></div>
    <canvas class="absolute inset-0 size-full" data-constellation></canvas>
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <p class="glass-soft inline-flex items-center gap-2.5 rounded-full px-3.5 py-1.5 text-xs font-medium text-text-2" data-reveal>
      <span class="pulse-dot size-2 rounded-full bg-mint-400"></span>
      {role.data.availability}
    </p>

    <h1 class="mt-8 font-display text-[2.7rem] leading-[1.04] font-extrabold tracking-tight sm:text-6xl lg:text-[5rem]">
      <span class="block">
        {firstLine.map(({ word, delay }) => <><span class="word" style={`--delay:${delay}ms`}>{word}</span>{" "}</>)}
      </span>
      <span class="word text-gradient pb-2" style={`--delay:${secondLineDelay}ms`}>{lineTwo}</span>
    </h1>

    <p class="mx-auto mt-7 max-w-xl text-base text-text-2 sm:text-lg" data-reveal style="--delay:550ms">
      {role.data.intro}
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-reveal style="--delay:700ms">
      <a href="#work" class="btn-primary !px-6 !py-3">See my work <Icon name="arrow-down" /></a>
      <a href="#live-demo" class="btn-ghost !px-6 !py-3"><Icon name="play" class="text-mint-400" /> Try {spotlightTitle} live</a>
    </div>
  </div>

  <a href="#about" class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-text-3 transition hover:text-text-1" aria-label="Scroll to About">
    <span class="block h-10 w-6 rounded-full border border-white/15">
      <span class="scroll-cue-dot mx-auto mt-2 block size-1.5 rounded-full bg-accent-300"></span>
    </span>
  </a>
</section>
