---
// Skills - grouped skill cards picked by the role (roles.yaml skillGroups)
import type { Profile } from "@/lib/content";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  skills: Profile["skills"];
}
const { skills } = Astro.props;
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionHeading
    eyebrow="Skills"
    title="What I bring to a project team"
    align="center"
  />
  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group, i) => (
        <div class="glass spotlight rounded-3xl p-6" data-reveal data-spotlight style={`--delay:${(i % 3) * 90}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-accent-500/12 text-accent-300 ring-1 ring-accent-400/25">
            <Icon name={group.icon} class="size-5" />
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold">{group.title}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
