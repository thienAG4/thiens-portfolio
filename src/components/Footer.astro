---
// Footer - name, section links, contact and how the site is built
import type { Profile } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  profile: Profile;
  base: string;
}
const { profile, base } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6">
  <div class="glass-soft flex flex-col gap-8 rounded-3xl p-6 sm:flex-row sm:items-start sm:justify-between sm:p-8">
    <div class="max-w-sm">
      <p class="font-display text-lg font-semibold">{profile.name}</p>
      <p class="mt-2 text-sm leading-relaxed text-text-3">
        Business analysis with working proof. This site is built with Astro; every project, number and diagram comes from
        YAML and Markdown files in the repository.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 text-sm">
      <div>
        <p class="text-xs font-semibold tracking-widest text-text-3 uppercase">Navigate</p>
        <ul class="mt-3 space-y-2 text-text-2">
          <li><a class="hover:text-text-1" href={`${base}/#work`}>Work</a></li>
          <li><a class="hover:text-text-1" href={`${base}/#skills`}>Skills</a></li>
          <li><a class="hover:text-text-1" href={`${base}/#journey`}>Journey</a></li>
          <li><a class="hover:text-text-1" href={`${base}/#contact`}>Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-widest text-text-3 uppercase">Contact</p>
        <ul class="mt-3 space-y-2 text-text-2">
          <li><a class="inline-flex items-center gap-2 hover:text-text-1" href={`mailto:${profile.email}`}><Icon name="mail" /> Email</a></li>
          <li><a class="inline-flex items-center gap-2 hover:text-text-1" href={profile.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a></li>
          <li><a class="inline-flex items-center gap-2 hover:text-text-1" href="https://github.com/thienAG4/thiens-portfolio" target="_blank" rel="noopener"><Icon name="code" /> Site source</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="mt-6 flex flex-col items-center justify-between gap-3 text-xs text-text-3 sm:flex-row">
    <p>© {year} {profile.name}</p>
    <a href="#" class="inline-flex items-center gap-1.5 hover:text-text-1">Back to top <Icon name="arrow-up-right" class="-rotate-45" /></a>
  </div>
</footer>
