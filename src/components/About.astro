---
// About - monogram with orbiting skills, a one-line summary, three pillars, the BA process as a
// step strip, and the numbers added up from the featured projects
import type { Profile, Role, Stat } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  role: Role;
  profile: Profile;
  stats: Stat[];
}
const { role, profile, stats } = Astro.props;
const orbit = role.data.orbit;
---

<section id="about" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <div class="grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="relative mx-auto aspect-square w-full max-w-[400px]" data-reveal aria-hidden="true">
      <div class="absolute inset-[14%] rounded-full border border-dashed border-white/10"></div>
      <div class="absolute inset-[30%] rounded-full border border-white/5"></div>
      <div class="absolute inset-[33%] grid place-items-center rounded-full glass">
        <span class="font-display text-5xl font-extrabold text-gradient sm:text-6xl">{profile.initials}</span>
      </div>
      <div class="orbit absolute inset-0">
        {
          orbit.map((label, i) => {
            const angle = (i / orbit.length) * Math.PI * 2 - Math.PI / 2;
            return (
              <span
                class="absolute -translate-x-1/2 -translate-y-1/2"
                style={`left:${50 + Math.cos(angle) * 42}%;top:${50 + Math.sin(angle) * 42}%`}
              >
                <span class="orbit-item glass-soft block rounded-full px-3 py-1.5 text-[11px] font-medium whitespace-nowrap text-text-2 sm:text-xs">
                  {label}
                </span>
              </span>
            );
          })
        }
      </div>
    </div>

    <div>
      <p class="eyebrow" data-reveal>About me</p>
      <h2 class="mt-5 font-display text-3xl font-bold tracking-tight sm:text-[2.6rem]" data-reveal>Hi, I'm {profile.shortName}.</h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-text-2" data-reveal style="--delay:80ms">{role.data.summary}</p>

      <ul class="mt-5 flex flex-wrap gap-2" data-reveal style="--delay:140ms">
        {
          profile.facts.map((fact) => (
            <li class="chip !py-1.5">
              <Icon name={fact.icon} class="text-accent-300" />
              {fact.value}
            </li>
          ))
        }
      </ul>

      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {
          role.data.pillars.map((pillar, i) => (
            <li class="glass spotlight rounded-2xl p-4" data-reveal data-spotlight style={`--delay:${200 + i * 90}ms`}>
              <span class="grid size-10 place-items-center rounded-xl bg-accent-500/12 text-accent-300 ring-1 ring-accent-400/25">
                <Icon name={pillar.icon} class="size-[18px]" />
              </span>
              <p class="mt-3 font-display text-[15px] font-semibold">{pillar.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-text-3">{pillar.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <ol class="process mt-20 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5" data-reveal aria-label="How I work">
    {
      role.data.process.map((step, i) => (
        <li class="process-step glass-soft relative flex items-center gap-3 rounded-2xl px-4 py-3" style={`--i:${i}`}>
          <span class="grid size-9 flex-none place-items-center rounded-xl bg-ink-900 text-accent-300 ring-1 ring-white/10">
            <Icon name={step.icon} class="size-[17px]" />
          </span>
          <span class="min-w-0">
            <span class="block text-[11px] font-semibold text-text-3 tabular-nums">0{i + 1}</span>
            <span class="block text-sm font-semibold text-text-1">{step.title}</span>
            <span class="block truncate text-[11px] text-text-3">{step.text}</span>
          </span>
        </li>
      ))
    }
  </ol>

  {
    stats.length > 0 && (
      <ul class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4" data-reveal style="--delay:120ms">
        {stats.map((stat) => (
          <li class="glass-soft spotlight rounded-2xl px-5 py-4" data-spotlight>
            <span class="block font-display text-4xl font-bold text-gradient tabular-nums" data-count={stat.value}>
              {stat.value}
            </span>
            <span class="mt-1 block text-xs text-text-3">{stat.label}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>
